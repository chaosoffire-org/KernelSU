MODEL="SM-A5560"
CSC="TGY"
FIRMWARE="A5560ZHUIEZJ1/A5560OZSIEZJ1/A5560ZCUIEZJ1/A5560ZHUIEZJ1"
BUILD_DATE="2026-10-06"
ANDROID_SPL="2026-10"
KERNEL_RELEASE="6.1.162-android14-11"
KERNEL_VERMAGIC="6.1.162-android14-11 SMP preempt mod_unload modversions aarch64"
KERNEL_COMPILER="Android clang 17.0.2 / LLD 17.0.2, built Tue Oct 6 04:58:27 UTC 2026"
KMI="android14-6.1"
ARCH="arm64"
PAGE_SIZE="4096"
VA_BITS="39 (4-level, 4K pages)"

# Verified against the boot.img in the pinned AP package (see verify-boot-image.py).
TARGET_CVE="CVE-2026-98260"
TARGET_CVE_STATE="VULNERABLE"
OTHER_CVE="CVE-2026-43499"
OTHER_CVE_STATE="PATCHED (Samsung SMR-OCT-2026 backport)"

# KernelSU-side integration facts.
KSU_RUNTIME_MODE="late-load (jailbreak); no boot image is written"
KSU_DRIVER_LINE="3.2.5 KDP/RKP/DEFEX-patched (3.3.x panics on this kernel)"
REQUIRED_COMPAT="KDP_CRED + RKP + DEFEX + FIVE + PROCA; no live text patching on Exynos"

# Samsung hardening present in this build.
SAMSUNG_HARDENING="RKP=y KDP=y KDP_CRED=y DEFEX=y(defex_user, imr_v2, link_protection) FIVE=y PROCA=y KNOX_NCM=y"
GENERIC_HARDENING="CFI_CLANG=y KASAN_HW_TAGS=y ARM64_MTE=y PANIC_ON_OOPS=y INIT_ON_ALLOC=y MODULE_SIG=y MODULE_SIG_FORCE=n"

# No-flash lockdown.
FLASH_LOCKDOWN="ksud hard refusal (late-load or marker) + preflight marker"
LOCKDOWN_MARKER="/data/adb/ksu/no-flash"
KERNEL_GUARD="CONFIG_KSU_BLOCKDEV_WRITE_GUARD (opt-in, unverified build)"

# Kernel-side CVE guard: minimal C entry + pure-Rust policy.
CVE_GUARD="KSU_CVE_2026_98260_GUARD=y (CLOCK_THREAD_CPUTIME_ID denied for all uids)"
CVE_GUARD_IMPL="C syscall entry (kCFI) + rust no_std policy, no unsafe/alloc"
CVE_GUARD_GAP="a timer armed before module load is not removed"
BLOCK_WRITE_GUARD="ksud refusal + kernel LSM (file_open/file_permission/mmap_file) scoped to ksu domain"
RESTRICTED_ROOT="KSU_RESTRICTED_ROOT=y (caps from app profile, clamped in kernel; block write + module load denied)"
RESTRICTED_CAPS_DEFAULT="CAP_FULL_SET minus SYS_ADMIN/SYS_MODULE/SYS_RAWIO/MKNOD/MAC_*/BPF/PERFMON/CHECKPOINT_RESTORE/SETPCAP"
RESTRICTED_CAPS_EBPF="profile adds CAP_BPF (clamp still removes the brick caps)"

# Manager signing identity for this fork (private key lives outside the repo;
# CI reads it from the KEYSTORE secret).
MANAGER_KEYSTORE_ALIAS="a5560"
MANAGER_CERT_SIZE="0x052f"
MANAGER_CERT_SHA256="6efd8c76b150c7d9d33954e8665770c1740d323289ab362a826996544148e57f"
